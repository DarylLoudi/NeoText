# NeoText configuration. Copy to .env and uncomment what you need.
# Values shown are the defaults unless noted. Never commit .env.

# Port the server listens on.
NEOTEXT_PORT=3420
# Directory for the database, backups, attachments and the instance key.
NEOTEXT_DATA_DIR=./data

# development, production or test. `npm start` and the Docker image use production.
# NODE_ENV=production
# Address to bind. Use 0.0.0.0 in a container; keep 127.0.0.1 behind a reverse proxy on the same host.
# NEOTEXT_HOST=127.0.0.1
# The URL people open in the browser, for example https://chat.example.com. Defaults to http://localhost:<port>.
# NEOTEXT_PUBLIC_URL=
# Extra browser origins allowed to call the API, comma separated. Usually not needed.
# NEOTEXT_ALLOWED_ORIGINS=
# true or false. Defaults to true when NEOTEXT_PUBLIC_URL starts with https.
# NEOTEXT_COOKIE_SECURE=
# true when a reverse proxy sets X-Forwarded-For, so rate limits see the real client address.
# Rate limits then key on the first X-Forwarded-For entry, which a client can forge unless the
# proxy overwrites (not appends to) the header. deploy/Caddyfile.example overwrites it. Only turn
# this on when the proxy is the only way to reach NeoText's port.
# NEOTEXT_TRUST_PROXY=false
# fatal, error, warn, info, debug, trace or silent. Defaults to info.
# NEOTEXT_LOG_LEVEL=info
# Folder with the built web app. Defaults to apps/web/dist when it exists.
# NEOTEXT_WEB_DIST=
# Argon2 memory cost in KiB for password hashing. Lower only for tests or very small hosts.
# NEOTEXT_ARGON2_MEMORY_KIB=65536
# Argon2 passes for password hashing.
# NEOTEXT_ARGON2_PASSES=2
# Hours between automatic database backups (1 to 596).
# NEOTEXT_BACKUP_INTERVAL_HOURS=6
# How many scheduled backups to keep.
# NEOTEXT_BACKUP_KEEP=10
# How many backups taken before a database upgrade to keep.
# NEOTEXT_BACKUP_KEEP_PREMIGRATION=5
# 32-byte key, standard base64, that protects server-held data. Unset: created in <data dir>/keys/instance.key.
# NEOTEXT_INSTANCE_KEY=

# Total size of attached files each user may store, in MB. Uploads past it are refused.
# NEOTEXT_ATTACHMENT_QUOTA_MB=2048

# Used by setup ("use the server's key") and npm run test:live.
# OPENROUTER_API_KEY=
